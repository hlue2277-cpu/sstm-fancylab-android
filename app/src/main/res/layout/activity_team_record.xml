<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.TeamRecordActivity">



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <FrameLayout
            android:id="@+id/fl_back"
            android:layout_width="40dp"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="15dp"
                android:src="@drawable/ic_back" />
        </FrameLayout>



        <TextView
            android:text="团队录入"
            android:textSize="16sp"
            android:textColor="#4D4D4D"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </RelativeLayout>

    <EditText
        android:id="@+id/et_conetnt"
        android:paddingLeft="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:background="@drawable/shape_manual_input_edittext"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <TextView
        android:id="@+id/continue_check_ticket"
        android:textColor="#ffffff"
        android:gravity="center"
        android:text="开始录入"
        android:layout_gravity="end"
        android:layout_marginRight="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/shape_check_ticket_continue"
        android:layout_centerHorizontal="true"
        android:layout_width="120dp"
        android:layout_height="40dp"/>

</LinearLayout>